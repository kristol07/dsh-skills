{
  "name": "__PLUGIN_NAME__",
  "version": "0.1.0",
  "description": "__PLUGIN_DESCRIPTION__",
  "license": "MIT",
  "author": "__PLUGIN_AUTHOR__",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/__PLUGIN_REPO__.git"
  },
  "homepage": "https://github.com/__PLUGIN_REPO__#readme",
  "bugs": {
    "url": "https://github.com/__PLUGIN_REPO__/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/publishing.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "npm run build && node --import tsx --test test/*.test.mjs",
    "verify:pack": "publint && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "release:check": "npm test && npm run verify:pack",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "publint": "^0.3.24",
    "react": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
